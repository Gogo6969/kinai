{
  "name": "kinai-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "KinAI monorepo \u2014 Rust backend + SvelteKit frontend",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "frontend:dev": "pnpm --filter kinai-frontend dev",
    "frontend:build": "pnpm --filter kinai-frontend build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "workspaces": [
    "frontend"
  ],
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "cookie@<0.7.0": "^0.7.2",
      "postcss-selector-parser@<6.1.3": ">=6.1.3"
    }
  }
}
